# Local-only connection for the provided Docker Compose setup.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# Choose ONE provider if you use an API; local embeddings do not need an API key.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# gemini (default) | openai | openrouter | local (needs: pip install sentence-transformers)
# GEMINI_API_KEY may also come from the OS environment instead of this file.
EMBEDDING_PROVIDER=gemini
# gemini: gemini-embedding-001 | openai: text-embedding-3-small | openrouter: openai/text-embedding-3-small
EMBEDDING_MODEL=gemini-embedding-001
# Gemini only: output dimensionality (768, 1536 or 3072)
EMBEDDING_DIMENSIONS=768
# Gemini only: texts per minute (free tier quota is 100)
EMBEDDING_MAX_PER_MINUTE=100
# openai/openrouter only: USD per 1M tokens from the provider's pricing page, used to report cost
EMBEDDING_PRICE_PER_1M_TOKENS=
